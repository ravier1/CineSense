NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: used for email authentication and PostgreSQL data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB: use either the API key or the Read Access Token.
# The Read Access Token is preferred and stays server-side.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# No Trakt API credentials are needed. CineSense imports Trakt ZIP/JSON exports.
